---
import { site } from '../data/site';
---
<div class="hero-links" aria-label="Profile links">
  <a class="profile-link" href={site.cv} aria-label="CV">
    <svg class="profile-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6.5 3.5h7l4 4V20.5h-11z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
      <path d="M13.5 3.5v4h4M8.8 12h6.4M8.8 15.5h6.4M8.8 19h4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
    </svg>
    <span>CV</span>
  </a>
  <a class="profile-link" href={site.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
    <svg class="profile-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5.2 8.6H2.8V21h2.4zM4 3a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M8 8.6h2.3v1.7h.1c.3-.7 1.2-2.1 3.5-2.1 3.7 0 4.4 2.4 4.4 5.5V21h-2.4v-6.5c0-1.5 0-3.4-2.1-3.4s-2.4 1.6-2.4 3.3V21H8z" fill="currentColor" />
    </svg>
    <span>LinkedIn</span>
  </a>
  <a class="profile-link" href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub">
    <svg class="profile-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2.7a9.4 9.4 0 0 0-3 18.3c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.7.4-1.1.6-1.3-2.2-.3-4.5-1.1-4.5-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.8 9.8 0 0 1 5.1 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.3 4.6-4.5 4.9.4.3.7 1 .7 1.9v2.8c0 .3.2.6.7.5A9.4 9.4 0 0 0 12 2.7" fill="currentColor" />
    </svg>
    <span>GitHub</span>
  </a>
  <a class="profile-link" href={site.scholar} target="_blank" rel="noreferrer" aria-label="Google Scholar">
    <svg class="profile-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="m2.5 9 9.5-5 9.5 5-9.5 5z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
      <path d="M6 11.2v4.1c0 1.8 2.7 3.5 6 3.5s6-1.7 6-3.5v-4.1M21.5 9v6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>Google Scholar</span>
  </a>
  <a class="profile-link" href={`mailto:${site.email}`} aria-label="Email">
    <svg class="profile-icon" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="5.5" width="18" height="13" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.7" />
      <path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>Email</span>
  </a>
</div>
